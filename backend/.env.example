NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://filo:filo@localhost:5432/filo
CORS_ORIGIN=http://localhost:3000
SUPABASE_URL=
SUPABASE_ANON_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Opzionale: client OAuth dedicato al login Google frontend.
# Deve coincidere con il client Google configurato in Supabase Auth se diverso da GOOGLE_CLIENT_ID.
GOOGLE_LOGIN_CLIENT_ID=
GOOGLE_LOGIN_CLIENT_SECRET=
# Opzionale: lista email abilitate al consenso OAuth quando l'app Google è in Testing
GOOGLE_OAUTH_TEST_USERS=

# Chiave server-side usata per cifrare le password degli account IMAP/SMTP.
# Se non impostata, il backend usa DATABASE_URL come fallback stabile.
# Deve restare stabile tra i deploy, altrimenti gli account "altra email" vanno ricollegati.
INBOX_CREDENTIALS_SECRET=
